# Both forms POST to same-origin /api/leads and /api/newsletter — Firebase
# Hosting rewrites /api/** to the Cloud Run API (see firebase.json), so
# there's no separate endpoint to configure here.

# Local dev escape hatch ONLY — set to "true" to make both forms simulate
# success locally without calling the API at all (e.g. if you're not
# running the API locally too). Never set this in production; the deploy
# workflow must never set it.
NEXT_PUBLIC_SIMULATE_FORMS=

# Optional. If unset, no Turnstile widget renders and both forms send an
# empty turnstileToken — the API only rejects that once its own
# TURNSTILE_SECRET_KEY (see api/.env.example) is configured. Set to the
# site key once a Cloudflare Turnstile account/widget exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. If unset, no analytics script loads at all. Set to the site's
# domain (e.g. lumenical.com) once a Plausible account/site exists for it —
# Plausible is cookieless, so this needs no consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
