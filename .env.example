# Both forms POST to same-origin /api/leads and /api/newsletter — Firebase
# Hosting rewrites /api/** to the Cloud Run API (see firebase.json), so
# there's no separate endpoint to configure here.

# Local dev escape hatch ONLY — set to "true" to make both forms simulate
# success locally without calling the API at all (e.g. if you're not
# running the API locally too). Never set this in production; the deploy
# workflow must never set it.
NEXT_PUBLIC_SIMULATE_FORMS=

# Optional. If unset, no Turnstile widget renders and both forms send an
# empty turnstileToken — the API only rejects that once its own
# TURNSTILE_SECRET_KEY (see api/.env.example) is configured. Set to the
# site key once a Cloudflare Turnstile account/widget exists.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional. If unset, no analytics script loads at all. Set to the site's
# domain (e.g. lumenical.com) once a Plausible account/site exists for it —
# Plausible is cookieless, so this needs no consent banner.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# The admin console (leads/newsletter/CMS/media/audit/email) is a separate
# app — see admin/.env.example for its Firebase config and emulator vars.

# CMS-driven public pages (docs/build-plan.md Phase 5): /demos/ and
# /insights/ read published content directly from Firestore at build time,
# via the public, unauthenticated read access firestore.rules already
# grants published docs — no admin credential needed, just these public
# identifiers (same project as admin/.env.example, different purpose).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# No live Firestore project exists yet (docs/infrastructure.md) — leave this
# unset and /demos/ + /insights/ render an empty "coming soon" state with
# zero Firestore calls attempted, so the build stays green regardless. Set
# to "true" only once Firestore is actually provisioned; from that point, an
# unreachable/misconfigured Firestore fails the build loudly rather than
# silently shipping an empty page.
NEXT_PUBLIC_CMS_LIVE=

# Local dev only — set to "true" (alongside NEXT_PUBLIC_CMS_LIVE=true) to
# point /demos/ and /insights/'s Firestore reads at the local emulator
# (127.0.0.1:8080, see firebase.json) instead of a real project. Never set
# this in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
