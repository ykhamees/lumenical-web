# Firebase Auth config for the console (public, client-side identifiers —
# not secrets). Get these from Firebase console > Project settings >
# General > Your apps > Web app, or `firebase apps:sdkconfig web`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Local dev only — set to "true" to point the client Firebase SDK at the
# local Auth + Firestore emulators (127.0.0.1:9099 / 127.0.0.1:8080) instead
# of a real project. Never set this in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# Local dev only — point firebase-admin (server-side: proxy.ts, the session
# route) at the local Auth emulator instead of a real project. Firebase's
# Admin SDK honors this automatically. Never set this in production.
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Server-only, never exposed to the browser. Base URL of the Python API
# (api/) that /api/admin/[...path]/route.ts proxies to. In production this
# is the api Cloud Run service's URL; locally, a locally-run `api/`
# instance (see api/README.md) — typically http://127.0.0.1:8000.
ADMIN_API_BASE_URL=
