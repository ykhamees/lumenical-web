# All optional. Unset in production is a real misconfiguration (bot
# protection and outbound email silently disabled) — unset locally is the
# expected, supported way to develop against the Firestore emulator.

GCP_PROJECT_ID=lumenical-ai

# Cloudflare Turnstile (O-4). Unset => bot verification is skipped.
TURNSTILE_SECRET_KEY=

# Resend (O-3). Unset => outbound email is skipped and logged as "skipped".
RESEND_API_KEY=
NOTIFY_EMAIL=hello@lumenical.com
FROM_EMAIL=Lumenical <hello@lumenical.com>

# GitHub repository_dispatch (4.7). Unset => publish/unpublish still work,
# but nothing rebuilds the static site until the next push to main. Needs a
# token with the `repo` scope (classic) or "Contents: write" (fine-grained)
# on GITHUB_REPOSITORY ("owner/repo") — repository_dispatch requires write
# access to the target repo.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPOSITORY=
